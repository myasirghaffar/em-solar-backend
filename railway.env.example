# =============================================================================
# Railway → your backend service → Variables
# Copy each line (name = value) into the Railway dashboard.
# =============================================================================
#
# Supabase plugin linked?
#   The plugin often injects DIRECT_URL pointing at db.*.supabase.co — that breaks on Railway.
#   DELETE variable DIRECT_URL on Railway if present.
#   Set DATABASE_URL only — copy the :5432 pooler line from em-solar-backend/.env (DIRECT_URL locally).
#
# After saving variables, redeploy the service.
# Test: https://em-solar-backend-production.up.railway.app/health
# =============================================================================

# --- Required — MUST work (test locally first, then paste exact URI here) ---
# For Node on Railway, prefer SESSION pooler (port 5432), not only transaction (6543):
# postgresql://postgres.geqhoiiqwlymljdgppco:URL_ENCODED_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
#
# Copy DATABASE_URL from your working em-solar-backend/.env (both lines if needed).
# If Supabase plugin injects a broken URL, OVERRIDE it with the .env value.
DATABASE_URL=<copy from local .env — session :5432 or transaction :6543>

JWT_ACCESS_SECRET=<copy from local .env — must match if same DB>
JWT_REFRESH_SECRET=<copy from local .env>

JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# --- Required for Vercel frontend (include live domain) ---
ALLOWED_ORIGINS=http://localhost:5173,https://energymart-pk.vercel.app,https://www.energymart.pk

FRONTEND_APP_URL=https://energymart-pk.vercel.app

# --- Optional ---
ENVIRONMENT=production
EMAIL_FROM=EnergyMart <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=
DEV_EXPOSE_EMAIL_LINKS=true
RESEND_API_KEY=
ADMIN_INVITE_SECRET=

# --- Usually from Supabase plugin (optional for current API code) ---
SUPABASE_URL=https://geqhoiiqwlymljdgppco.supabase.co
SUPABASE_ANON_KEY=<Supabase → Settings → API → anon>
SUPABASE_SERVICE_ROLE_KEY=<Supabase → Settings → API → service_role>

# PORT — do not set; Railway provides automatically
