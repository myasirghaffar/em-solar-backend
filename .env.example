# =============================================================================
# EM Solar API — copy to `.env` for local dev (npm run dev / db:* scripts)
# =============================================================================
# Production API: Railway  |  Storefront: Vercel  |  Database: Supabase
# See `railway.env.example` for variables to paste in Railway dashboard.
# =============================================================================

# --- Supabase Postgres ---
# Railway: if Supabase plugin is linked, it usually injects DATABASE_URL for you.
# Local: paste Transaction pooler URI (port 6543), user postgres.<project-ref>, URL-encoded password.
#
# Project ref: geqhoiiqwlymljdgppco
# Host: aws-1-ap-south-1.pooler.supabase.com
DATABASE_URL=
# Optional local migrations (session pooler, port 5432) — used by npm run db:apply-sql-schema
DIRECT_URL=

# --- Auth (required on Railway — use the SAME values as local if you share one database) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# --- CORS — exact Vercel URL(s), comma-separated, no trailing slash ---
ALLOWED_ORIGINS=http://localhost:5173,https://energymart-pk.vercel.app

# --- App URLs / email ---
FRONTEND_APP_URL=https://energymart-pk.vercel.app
RESEND_API_KEY=
EMAIL_FROM=EnergyMart <onboarding@resend.dev>
DEV_EXPOSE_EMAIL_LINKS=true
ADMIN_INVITE_SECRET=

# --- Supabase REST (optional; often auto-set when Supabase is linked on Railway) ---
SUPABASE_URL=https://geqhoiiqwlymljdgppco.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local seed only (`npm run db:seed-admin`) ---
ADMIN_EMAIL=admin@energymart.pk
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=EnergyMart Admin

ENVIRONMENT=development
DEPLOYED_AT=
BUILD_TIME=
GIT_COMMIT=
GIT_COMMIT_SHORT=
